---
// src/components/ui/WhatsAppIcon.astro
// Ícone de WhatsApp (PNG fornecido em src/assets/images/icone-wpp.png),
// para uso dentro de botões de texto/link.
// Não confundir com o ícone do botão flutuante (WhatsAppFloat.astro), que é
// um SVG desenhado à mão, à parte deste asset.

import { Image } from 'astro:assets';
import whatsappIconSrc from '../../assets/images/icone-wpp.png';

interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className } = Astro.props;
---

<Image
  src={whatsappIconSrc}
  alt=""
  aria-hidden="true"
  width={size}
  height={size}
  class:list={['whatsapp-icon-inline', className]}
  style="flex-shrink:0"
/>
