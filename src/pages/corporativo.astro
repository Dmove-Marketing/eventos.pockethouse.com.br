            { type: 'row', fields: [
              { name: 'nome',     type: 'text', label: 'Nome',     placeholder: 'Seu nome completo',  required: true },
              { name: 'telefone', type: 'tel',  label: 'Telefone', placeholder: '(11) 90000-0000',    required: true },
            ]},
            { name: 'email',   type: 'email', label: 'E-mail',  placeholder: 'seu@email.com', required: true, full: true },
