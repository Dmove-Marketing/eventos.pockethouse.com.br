---
// Gerado a partir de: eventos-corporativos.html
import Base from '../layouts/Base.astro';
import Img from '../components/ui/Img.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { getImage } from 'astro:assets';
import heroRaw from '../assets/images/hero.pocket_resultado.webp';
import { WA_FALLBACK_MESSAGE, buildWhatsAppUrl } from '../lib/whatsapp-message';
import '../styles/eventos-corporativos.css';

const bgHero = await getImage({ src: heroRaw });
const fallbackWaUrl = buildWhatsAppUrl(WA_FALLBACK_MESSAGE);
---

<Base
  title="Espaços para Eventos Corporativos · São Paulo"
  ogImage="/pocket.house-ogImages.png"
>
<!-- NAVBAR -->
    <nav>
        <a href="#" class="logo">
            <Img src="logo pocket house colorido.png" alt="Pocket House" width={200} priority class="nav-logo-img" />
        </a>

        <ul class="nav-links">
            <li><a href="#unidades">Nossas Unidades</a></li>
            <li><a href="#galeria">Galeria</a></li>
            <li><a href="#contato">Contato</a></li>
            <li><a href="#formulario" class="nav-cta">Solicitar orçamento</a></li>
        </ul>
    </nav>

    <!-- HERO -->
    <section class="hero" id="formulario" style={`background-image: url(${bgHero.src}); background-size: cover; background-position: center;`}>
        <div class="hero-overlay"></div>
        <div class="hero-left">
            <div class="hero-badge">Eventos corporativos · São Paulo</div>

            <h1>Eventos corporativos com estrutura, personalização e <em>impacto real.</em></h1>

            <p class="hero-desc">Conheça nossos espaços, localizados em endereços privilegiados de São Paulo, projetados
                para transformar cada evento em uma experiência memorável.</p>


        </div>

        <div class="hero-right">
            <div class="form-card">
                <h3 class="form-title">Solicite um orçamento</h3>
                <p class="form-subtitle">Fale com nossa equipe pelo WhatsApp e receba uma proposta personalizada para o seu evento.</p>
                <a class="btn btn-primary" style="width:100%;justify-content:center;margin-top:1.5rem" href={fallbackWaUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-cta>
                    <WhatsAppIcon size={22} />
                    Falar no WhatsApp
                    <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:none;stroke:white;stroke-width:2;stroke-linecap:round">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                </a>
                <p class="form-note">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    Resposta rápida. Sem compromisso.
                </p>
            </div>
        </div>
    </section>



    <!-- UNIDADES -->
    <section class="units-section" id="unidades">
        <div class="section-header">
            <span class="section-tag">Nossas unidades</span>
            <h2>Encontre o espaço ideal<br><span class="text-green">para o seu evento</span></h2>
            <p class="section-lead">Três unidades exclusivas em São Paulo, cada uma projetada para receber eventos
                corporativos com sofisticação e estrutura completa.</p>
        </div>

        <div class="units-grid">
            <!-- Card 1 -->
            <div class="unit-card">
                <Img src="Villa-lobos.pocket_resultado.webp" alt="Villa Lobos" class="unit-image" />
                <div class="unit-body">
                    <h3 class="unit-name">Villa Lobos</h3>
                    <span class="unit-capacity">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Até 230 pessoas
                    </span>
                    <a class="btn btn-outline" href={fallbackWaUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-cta>Solicitar orçamento</a>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="unit-card">
                <Img src="Alto-pinheiros.pocket_resultado.webp" alt="Alto de Pinheiros" class="unit-image" />
                <div class="unit-body">
                    <h3 class="unit-name">Alto de Pinheiros</h3>
                    <span class="unit-capacity">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Até 80 pessoas
                    </span>
                    <a class="btn btn-outline" href={fallbackWaUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-cta>Solicitar orçamento</a>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="unit-card">
                <Img src="Panamericana.pocket_resultado.webp" alt="Panamericana" class="unit-image" />
                <div class="unit-body">
                    <h3 class="unit-name">Panamericana</h3>
                    <span class="unit-capacity">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Até 150 pessoas
                    </span>
                    <a class="btn btn-outline" href={fallbackWaUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-cta>Solicitar orçamento</a>
                </div>
            </div>
        </div>
    </section>

    <!-- GALERIA -->
    <section class="gallery-section" id="galeria">
        <div class="section-header">
            <span class="section-tag">Galeria</span>
            <h2>Conheça nossos espaços</h2>
        </div>

        <div class="gallery-grid">
            <div class="gallery-item g1"><Img src="galeria01.pocket_resultado.webp" alt="Galeria 1" /></div>
            <div class="gallery-item g2"><Img src="galeria02.pocket_resultado.webp" alt="Galeria 2" /></div>
            <div class="gallery-item g3"><Img src="galeria03.pocket_resultado.webp" alt="Galeria 3" /></div>
            <div class="gallery-item g4"><Img src="galeria04.pocket_resultado.webp" alt="Galeria 4" /></div>
            <div class="gallery-item g5"><Img src="galeria05.pocket_resultado.webp" alt="Galeria 5" /></div>
            <div class="gallery-item g6"><Img src="galeria06.pocket_resultado.webp" alt="Galeria 6" /></div>
        </div>

        <div class="gallery-cta">
            <a class="btn btn-primary btn-lg" href={fallbackWaUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-cta>
                <WhatsAppIcon size={22} />
                Solicitar orçamento
                <svg viewBox="0 0 24 24"
                    style="width:16px;height:16px;fill:none;stroke:white;stroke-width:2;stroke-linecap:round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </a>
        </div>
    </section>

    <!-- DEPOIMENTOS -->
    <section class="testimonials-section" id="depoimentos">
        <div class="section-header">
            <span class="section-tag">Prova social</span>
            <h2>O que nossos clientes dizem</h2>
        </div>

        <div class="testimonials-grid">

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Excelente lugar onde tive uma experiência corporativa única!</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">AG</div>
                    <span class="testimonial-name">André Guaraldo</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Um ótimo lugar com uma ótima equipe de profissionais para realizar eventos
                    de qualidade.</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">GM</div>
                    <span class="testimonial-name">Gregori Murakami</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Evento do Google para o setor financeiro que ocorreu nesse espaço, foi
                    genial!</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">JB</div>
                    <span class="testimonial-name">João Bosco</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Lugar muito bonito e agradável para fazer e participar de eventos. Nota 10.
                </p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">EW</div>
                    <span class="testimonial-name">Evandro Welupek</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Local super agradável e magnífico para eventos de negócios. A área verde
                    intimista convida ao networking.</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">RD</div>
                    <span class="testimonial-name">Renato Douglas</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Uma casa de eventos bem confortável, com ar-condicionado até na área
                    exterior que era coberta, gostei muito desse lugar!</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">AS</div>
                    <span class="testimonial-name">Andy Sennin</span>
                </div>
            </div>

        </div>

        <div class="gallery-cta">
            <a class="btn btn-primary btn-lg" href={fallbackWaUrl} target="_blank" rel="noopener noreferrer" data-whatsapp-cta>
                <WhatsAppIcon size={22} />
                Solicitar orçamento
                <svg viewBox="0 0 24 24"
                    style="width:16px;height:16px;fill:none;stroke:white;stroke-width:2;stroke-linecap:round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="footer-logo">
            <Img src="logo pocket house colorido.png" alt="Pocket House" width={160} class="footer-logo-img" />
        </div>
        <div class="footer-text">© 2026 Pocket House · Todos os direitos reservados</div>
        <div class="footer-dmove">
            <span>Desenvolvido por</span>
            <a href="https://dmove.com.br" target="_blank" rel="noopener noreferrer">
                <img src="https://dmove.com.br/wp-content/webp-express/webp-images/uploads/2024/01/Logotipo-2048x858.png.webp" alt="Dmove Marketing" class="footer-dmove-logo" />
            </a>
        </div>
    </footer>

    <WhatsAppFloat />

</Base>
<script>
  import '../scripts/whatsapp.ts';
  import '../scripts/eventos-corporativos.js';
</script>
