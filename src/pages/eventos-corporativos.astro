---
// Gerado a partir de: eventos-corporativos.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';
import Img from '../components/ui/Img.astro';
import '../styles/eventos-corporativos.css';
---

<Base
  title="Espaços para Eventos Corporativos · São Paulo"
  ogImage="/images/og-eventos-corporativos.jpg"
>
<!-- NAVBAR -->
    <nav>
        <a href="#" class="logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" />
                    <polyline points="9 22 9 12 15 12 15 22" style="fill:none;stroke:white;stroke-width:1.5" />
                </svg>
            </div>
            <span class="logo-text">Espaços<span>SP</span></span>
        </a>

        <ul class="nav-links">
            <li><a href="#unidades">Nossas Unidades</a></li>
            <li><a href="#galeria">Galeria</a></li>
            <li><a href="#contato">Contato</a></li>
            <li><a href="#formulario" class="nav-cta">Solicitar orçamento</a></li>
        </ul>
    </nav>

    <!-- HERO -->
    <section class="hero" id="formulario">
        <div class="hero-left">
            <div class="hero-badge">Eventos corporativos · São Paulo</div>

            <h1>Eventos corporativos com estrutura, personalização e <em>impacto real.</em></h1>

            <p class="hero-desc">Conheça nossos espaços, localizados em endereços privilegiados de São Paulo, projetados
                para transformar cada evento em uma experiência memorável.</p>


        </div>

        <div class="hero-right">
            <div class="form-card">
                <h3 class="form-title">Solicite um orçamento</h3>
                <p class="form-subtitle">Preencha abaixo e nossa equipe retorna em até 24 horas.</p>

                <LeadForm
                  formId="lead-form"
                  project={config.project_slug}
                  submitUrl={config.forms['lead-form'].webhooks[0]}
                  redirectUrl={config.forms['lead-form'].redirect_on_success}
                  submitText="Solicitar orçamento"
                  honeypot
                  fields={[

                  ]}
                />

                <p class="form-note">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    Seus dados estão protegidos. Sem spam.
                </p>
            </div>
        </div>
    </section>



    <!-- UNIDADES -->
    <section class="units-section" id="unidades">
        <div class="section-header">
            <span class="section-tag">Nossas unidades</span>
            <h2>Encontre o espaço ideal para o seu evento</h2>
            <p class="section-lead">Três unidades exclusivas em São Paulo, cada uma projetada para receber eventos
                corporativos com sofisticação e estrutura completa.</p>
        </div>

        <div class="units-grid">
            <!-- Card 1 -->
            <div class="unit-card">
                <div class="unit-image-placeholder unit-img-1">
                    <svg viewBox="0 0 24 24" fill="rgba(55,137,136,0.5)">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" />
                    </svg>
                </div>
                <div class="unit-body">
                    <h3 class="unit-name">Villa Lobos</h3>
                    <span class="unit-capacity">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Até 230 pessoas
                    </span>
                    <button class="btn btn-outline" onclick="scrollToForm()">Solicitar orçamento</button>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="unit-card">
                <div class="unit-image-placeholder unit-img-2">
                    <svg viewBox="0 0 24 24" fill="rgba(55,137,136,0.5)">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" />
                    </svg>
                </div>
                <div class="unit-body">
                    <h3 class="unit-name">Alto de Pinheiros</h3>
                    <span class="unit-capacity">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Até 80 pessoas
                    </span>
                    <button class="btn btn-outline" onclick="scrollToForm()">Solicitar orçamento</button>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="unit-card">
                <div class="unit-image-placeholder unit-img-3">
                    <svg viewBox="0 0 24 24" fill="rgba(55,137,136,0.5)">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z" />
                    </svg>
                </div>
                <div class="unit-body">
                    <h3 class="unit-name">Panamericana</h3>
                    <span class="unit-capacity">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Até 160 pessoas
                    </span>
                    <button class="btn btn-outline" onclick="scrollToForm()">Solicitar orçamento</button>
                </div>
            </div>
        </div>
    </section>

    <!-- GALERIA -->
    <section class="gallery-section" id="galeria">
        <div class="section-header">
            <span class="section-tag">Galeria</span>
            <h2>Conheça nossos espaços</h2>
        </div>

        <div class="gallery-grid">
            <div class="gallery-item g1">
                <div class="gph gph-1" style="height:100%">
                    <svg viewBox="0 0 24 24">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            stroke="white" stroke-width="1.5" fill="none" />
                        <circle cx="12" cy="13" r="4" stroke="white" stroke-width="1.5" fill="none" />
                    </svg>
                </div>
            </div>
            <div class="gallery-item g2">
                <div class="gph gph-2" style="height:100%">
                    <svg viewBox="0 0 24 24">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            stroke="white" stroke-width="1.5" fill="none" />
                        <circle cx="12" cy="13" r="4" stroke="white" stroke-width="1.5" fill="none" />
                    </svg>
                </div>
            </div>
            <div class="gallery-item g3">
                <div class="gph gph-3" style="height:100%">
                    <svg viewBox="0 0 24 24">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            stroke="white" stroke-width="1.5" fill="none" />
                        <circle cx="12" cy="13" r="4" stroke="white" stroke-width="1.5" fill="none" />
                    </svg>
                </div>
            </div>
            <div class="gallery-item g4">
                <div class="gph gph-4" style="height:100%">
                    <svg viewBox="0 0 24 24">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            stroke="white" stroke-width="1.5" fill="none" />
                        <circle cx="12" cy="13" r="4" stroke="white" stroke-width="1.5" fill="none" />
                    </svg>
                </div>
            </div>
            <div class="gallery-item g5">
                <div class="gph gph-5" style="height:100%">
                    <svg viewBox="0 0 24 24">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            stroke="white" stroke-width="1.5" fill="none" />
                        <circle cx="12" cy="13" r="4" stroke="white" stroke-width="1.5" fill="none" />
                    </svg>
                </div>
            </div>
            <div class="gallery-item g6">
                <div class="gph gph-6" style="height:100%">
                    <svg viewBox="0 0 24 24">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
                            stroke="white" stroke-width="1.5" fill="none" />
                        <circle cx="12" cy="13" r="4" stroke="white" stroke-width="1.5" fill="none" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="gallery-cta">
            <button class="btn btn-primary btn-lg" onclick="scrollToForm()">
                Solicitar orçamento
                <svg viewBox="0 0 24 24"
                    style="width:16px;height:16px;fill:none;stroke:white;stroke-width:2;stroke-linecap:round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    </section>

    <!-- DEPOIMENTOS -->
    <section class="testimonials-section" id="depoimentos">
        <div class="section-header">
            <span class="section-tag">Prova social</span>
            <h2>O que nossos clientes dizem</h2>
        </div>

        <div class="testimonials-grid">

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Excelente lugar onde tive uma experiência corporativa única!</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">AG</div>
                    <span class="testimonial-name">André Guaraldo</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Um ótimo lugar com uma ótima equipe de profissionais para realizar eventos
                    de qualidade.</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">GM</div>
                    <span class="testimonial-name">Gregori Murakami</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
                <p class="testimonial-text">Evento do Google para o setor financeiro que ocorreu nesse espaço, foi
                    genial!</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">JB</div>
                    <span class="testimonial-name">João Bosco</span>
                </div>
            </div>

            <div class="testimonial-card">
                <div class="testimonial-stars">
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    <svg viewBox="0 0 24 24">
                        <path
