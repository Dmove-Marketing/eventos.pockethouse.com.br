---
// Gerado a partir de: bio.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/bio.css';
---

<Base
  title="EspaçosSP — Solicitação de Orçamento"
  description="Espaços para eventos corporativos em São Paulo. Villa Lobos, Alto de Pinheiros e Panamericana. Solicite seu orçamento."
  ogImage="/images/og-bio.jpg"
>
<!-- ═══════════════════════════════════════════
     BACKGROUND: troque "BACKGROUND-AQUI.jpg"
     pelo caminho ou URL da sua imagem de fundo
     ═══════════════════════════════════════════ -->
  <div class="bg-image"></div>

  <div class="page">

    <!-- HEADER -->
    <div class="header">
      <div class="logo-wrap">
        <!-- ═══════════════════════════════════════════
           LOGO: troque "LOGO-AQUI.png" pelo caminho
           ou URL da sua imagem de logo
           ═══════════════════════════════════════════ -->
        <Img src="LOGO-AQUI.png" alt="EspaçosSP" priority />
      </div>

      <div class="brand-name">Espaços<span>SP</span></div>

      <div class="badge">Eventos corporativos · São Paulo</div>

      <h1 class="headline">Seu evento. Sua essência. <em>Seu Espaço.</em></h1>

      <p class="subline">Estrutura completa, endereços privilegiados e personalização para transformar cada encontro em
        uma experiência memorável.</p>
    </div>

    <!-- UNITS -->
    <div class="units">
      <span class="unit-chip">
        <svg viewBox="0 0 24 24">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
        Villa Lobos
      </span>
      <span class="unit-chip">
        <svg viewBox="0 0 24 24">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
        Alto de Pinheiros
      </span>
      <span class="unit-chip">
        <svg viewBox="0 0 24 24">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
        Panamericana
      </span>
    </div>

    <!-- FORM CARD -->
    <div class="form-card">
      <div class="form-top-bar"></div>

      <!-- FORM -->
      <div class="form-body" id="formWrap">
        <h2 class="form-title">Solicite um orçamento</h2>
        <p class="form-subtitle">Preencha abaixo e nossa equipe retorna em até 24 horas.</p>

        <LeadForm
          formId="lead-form"
          project={config.project_slug}
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Enviar solicitação"
          honeypot
          fields={[

          ]}
        />

        <p class="form-note">
          <svg viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          Seus dados estão protegidos. Sem spam.
        </p>
      </div>

      <!-- SUCCESS -->
      <div class="success-msg" id="successMsg">
        <div class="success-icon">
          <svg viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <div class="success-title">Solicitação recebida!</div>
        <p class="success-text">Recebemos seu pedido de orçamento.<br>Em breve entraremos em contato pelo WhatsApp ou
          e-mail.</p>
      </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
      <span class="footer-copy">© 2025 EspaçosSP · Todos os direitos reservados</span>
      <a href="mailto:contato@espacosp.com.br" class="footer-link">contato@espacosp.com.br</a>
    </div>

  </div>

  
</Base>
<script>
  import '../scripts/bio.js';
</script>
