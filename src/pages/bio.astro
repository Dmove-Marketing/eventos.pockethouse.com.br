---
// Gerado a partir de: bio.html
import Base from '../layouts/Base.astro';
import Img from '../components/ui/Img.astro';
import { getImage } from 'astro:assets';
import bgHeroRaw from '../assets/images/hero.pocket_resultado.webp';
import '../styles/bio.css';

const bgHero = await getImage({ src: bgHeroRaw });
---

<Base
  title="EspaçosSP — Solicitação de Orçamento"
  description="Espaços para eventos corporativos em São Paulo. Villa Lobos, Alto de Pinheiros e Panamericana. Solicite seu orçamento."
  ogImage="/pocket.house-ogImages.png"
>
<!-- ═══════════════════════════════════════════
     BACKGROUND: troque "BACKGROUND-AQUI.jpg"
     pelo caminho ou URL da sua imagem de fundo
     ═══════════════════════════════════════════ -->
<div class="bg-image" style={`background-image: url(${bgHero.src})`}></div>

<div class="page">

  <!-- HEADER -->
  <div class="header">
    <div class="logo-wrap">
      <!-- ═══════════════════════════════════════════
           LOGO: troque "LOGO-AQUI.png" pelo caminho
           ou URL da sua imagem de logo
           ═══════════════════════════════════════════ -->
      <Img src="logo pocket house colorido.png" alt="Pocket House" width={360} priority />
    </div>

    <div class="badge">Eventos corporativos · São Paulo</div>

    <h1 class="headline">Seu evento. Sua essência. <em>Seu Espaço.</em></h1>

  </div>


  <!-- CTA CARD -->
  <div class="form-card">
    <div class="form-top-bar"></div>
    <div class="form-body">
      <h2 class="form-title">Solicite um orçamento</h2>
      <p class="form-subtitle">Fale com nossa equipe pelo WhatsApp e receba uma proposta personalizada para o seu evento.</p>
      <button class="btn-submit" onclick="openWhatsApp()">
        <span class="btn-text">Falar no WhatsApp</span>
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
      <p class="form-note">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Resposta rápida. Sem compromisso.
      </p>
    </div>
  </div>


</div>

<footer>
  <div class="footer-logo">
    <Img src="logo pocket house colorido.png" alt="Pocket House" width={160} class="footer-logo-img" />
  </div>
  <div class="footer-text">© 2026 Pocket House · Todos os direitos reservados</div>
  <div class="footer-dmove">
    <span>Desenvolvido por</span>
    <a href="https://dmove.com.br" target="_blank" rel="noopener noreferrer">
      <img src="https://dmove.com.br/wp-content/webp-express/webp-images/uploads/2024/01/Logotipo-2048x858.png.webp" alt="Dmove Marketing" class="footer-dmove-logo" />
    </a>
  </div>
</footer>

</Base>
<script>
  import '../scripts/whatsapp.ts';
  import '../scripts/bio.js';
</script>
